#!/usr/bin/w
function transpose()
{
    local file_in="$1"
    local file_out="$2"
    local transpose_semitones="$3"

    # Calculate cents offset
    echo $transpose_semitones
    local transpose_cents=$(( 100 * $transpose_semitones ))

    # Perform transpose
    sox "$file_in" "$file_out" pitch "$transpose_cents"
}

export MEDIA_DIR="/opt/jellyfin/media"
export MEDIA_DIR_CREATION="${MEDIA_DIR}/produce"
export MEDIA_DIR_MUSIC="${MEDIA_DIR}/consume/music"
export MEDIA_DIR_TV="${MEDIA_DIR}/consume/tv"
export MEDIA_DIR_MOVIES="${MEDIA_DIR}/consume/movies"

function jcp()
{
	local src="$1"
	if [ -z "$src" ]
	then
		echo "Usage: ${FUNCNAME} <src> <dst>" 2>&1
		return -1
	fi

	local dest="$2"
	if [ -z "$src" ]
	then
		echo "Usage: ${FUNCNAME} <src> <dst>" 2>&1
		return -1
	fi

	sudo rsync -a --chown=jellyfin:jellyfin "$src" "$dest"
}

function jelly()
{
    if [ "$1" == "commit" ]
    then
        local file="$2"
        if [ -z "$file" ]
        then
            _jelly_usage
            return -1
        fi

        local file_basename="$(basename "$file")"
        sudo rsync -a --chown=jellyfin:jellyfin "$file" "${MEDIA_DIR_CREATION}/${file_basename}"
        #sudo rsync -a --chown=jellyfin:jellyfin "$file" "${MEDIA_DIR_MUSIC}/${file_basename}"
    fi
}

function _jelly_usage()
{
    echo 'Usage: jelly
    [commit] <file>' 2>&1
}

function _jelly_complete_function()
{
	echo "hi"
}

function _jelly_complete()
{
    local cmd=$1 cur=$2 pre=$3
    case $COMP_CWORD in
        1)
            COMPREPLY=( $(compgen -W "commit" "$cur") )
            ;;
        2)
			if [ "$pre" == "commit" ]
			then
				echo "cmd=${cmd}"
				echo "cur=${cur}"
				echo "pre=${pre}"
				COMPREPLY=( $(compgen -f) )
			fi
            ;;
        *)
            COMPREPLY=()
            ;;
    esac
}
complete -F _jelly_complete jelly

function yt()
{
	local url="$1"
    if [ -z "$url" ]
    then
		echo 'Usage: yt <url> <file>' 2>&1
		return -1
	fi

	local file="$2"
	if [ -z "$file" ]
	then
		yt-dlp --extract-audio --audio-format wav "$url"
	else
		yt-dlp --extract-audio --audio-format wav "$url" -o "$file"
	fi

}
